# Cross builds execute desktop tools, never packaged UWP executables.
set(ALICE_HOST_TOOLS_DIR "" CACHE PATH "Directory containing desktop generator executables")
set(ALICE_GENERATORS ParserGenerator DCONGENERATOR DCONINTERFACEGEN DataContainer-Lua DataContainer_OOS_Reporter)
if(CMAKE_SYSTEM_NAME STREQUAL "WindowsStore" AND NOT ALICE_HOST_TOOLS_DIR)
    message(FATAL_ERROR "UWP requires ALICE_HOST_TOOLS_DIR from a separate desktop build")
endif()
foreach(tool IN LISTS ALICE_GENERATORS)
    if(ALICE_HOST_TOOLS_DIR)
        set(executable "${ALICE_HOST_TOOLS_DIR}/${tool}.exe")
        if(NOT EXISTS "${executable}")
            message(FATAL_ERROR "Missing desktop generator: ${executable}")
        endif()
        add_executable(AliceHost_${tool} IMPORTED GLOBAL)
        set_target_properties(AliceHost_${tool} PROPERTIES IMPORTED_LOCATION "${executable}")
        set(ALICE_TOOL_${tool} AliceHost_${tool})
    else()
        set(ALICE_TOOL_${tool} ${tool})
    endif()
endforeach()
